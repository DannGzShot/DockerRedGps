#!/usr/bin/env bash
# Autor: DannGzShot
# Fecha de creacion: 16/03/2026
# Descripcion: Actualiza repos de aplicacion con rebase y autostash para mantenerlos compatibles con Docker local.

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
project_root="$(cd -- "$script_dir/../.." && pwd -P)"
git_tools="$project_root/bin/git-tools.sh"
environment="${1:-all}"
mode="${2:-pull}"

required_repos=(redgps partners reportes atomic commons)
optional_repos=(alertas api)

case "$environment" in
  all|dev|qa)
    ;;
  *)
    echo "Ambiente invalido: $environment. Usa all, dev o qa." >&2
    exit 1
    ;;
esac

case "$mode" in
  pull|--status|status)
    ;;
  *)
    echo "Modo invalido: $mode. Usa pull o --status." >&2
    exit 1
    ;;
esac

if [[ "$environment" == "all" ]]; then
  environments=(dev qa)
else
  environments=("$environment")
fi

update_repo() {
  local repo_path="$1"
  local label="$2"

  if [[ ! -d "$repo_path" ]]; then
    echo "SKIP: $label no existe."
    return
  fi

  if [[ "$mode" == "--status" || "$mode" == "status" ]]; then
    bash "$git_tools" update-path --repo "$repo_path" --remote "${REMOTE:-origin}" --label "$label" --status
  else
    bash "$git_tools" update-path --repo "$repo_path" --remote "${REMOTE:-origin}" --label "$label"
  fi
}

failed=0

for env_name in "${environments[@]}"; do
  for repo_name in "${required_repos[@]}"; do
    update_repo "$project_root/$env_name/$repo_name" "$env_name/$repo_name" || failed=1
  done

  for repo_name in "${optional_repos[@]}"; do
    if [[ -d "$project_root/$env_name/$repo_name" ]]; then
      update_repo "$project_root/$env_name/$repo_name" "$env_name/$repo_name" || failed=1
    fi
  done
done

exit "$failed"
